{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.php",
      "use": "vercel-php"
    },
    {
      "src": "api/*.php",
      "use": "vercel-php"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/splash.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
